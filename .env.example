# GhostMode - Environment Configuration Template
# Copy this file to '.env' or '.env.local' and adjust variables as needed.

# 1. API Base URL
# The endpoint where the frontend will request telemetry reports and system status.
# Example: http://localhost:8000/api
VITE_API_URL=http://localhost:5000/api

# 2. WebSocket URL
# The real-time telemetry feed endpoint (useful for live event streams, status dot updates, etc.)
# Example: ws://localhost:8000/telemetry
VITE_WS_URL=ws://localhost:5000/telemetry

# 3. Development / Mock Mode
# Set to 'true' to use the client-side telemetry simulation and fake data providers.
# Set to 'false' to route requests to the actual backend specified in VITE_API_URL and VITE_WS_URL.
VITE_USE_MOCK_DATA=true
